@using Microsoft.IdentityModel.Tokens
@model List<DevConnectTorloni.Models.Publicacao>
@* chamamos a model na primeira linha da view pois vincula a model com a view, e utiliza as propiedades 
da model atraves de atributos dos elementos, assim como tambem exibe valores dos atributos que representam um objeto *@

<link rel="stylesheet" href="~/css/feed.css" />

<script defer>
    const publicacaoNovaCadastrada = "@ViewBag.PublicacaoCadastrada";

    if (publicacaoNovaCadastrada == "Nao Cadastrada") {
        alert("Usuário não cadastrado! Tente novamente 😔");
    }
    else if (publicacaoNovaCadastrada == "Cadastrada") {
        alert("Publicação postada...");
    }

</script>

<h1>Tela Feed - DevConnect</h1>


<header id="cabecalho">
    <nav>
        <a id="logo-desktop" href="./feed.html">
            <img src="../images/DevConnect 2.svg" alt="Logo da empresa DevConnect">
        </a>
        <a id="logo-mobile" href="./feed.html">
            <img src="../images/DevConnect 3.svg" alt="Logo da empresa DevConnect">
        </a>

        <div class="cabecalho-acoes">
            <a href="./feed.html">
                <img src="../images/botao casinha verde.svg" alt="Icone de uma casa na cor verde">
            </a>

            <a href="#">
                <img src="../images/botao coracao verde.svg" alt="Icone de um coracao na cor verde">
            </a>

            <a href="./perfil.html">
                <img class="foto-perfil" src="../images/1744867899-virginia-instagram.webp" alt="Foto de perfil">
            </a>

        </div>

    </nav>
</header>


        <section id="cadastro-publi" class="estilo-formulario">
            <h2>Publicação</h2>

            @* quando a view recebe via form os dados, enviamos para a controller *@

            <form asp-action="Index" asp-controller="Feed" enctype="multipart/form-data">
                <textarea name="Descricao" placeholder="Digite a descrição do post..." required></textarea>

                <footer>
                    <label id="texto-upload" for="campo-upload">Faça upload da sua imagem aqui...</label>
                    <input type="file" name="Imagem" id="campo-upload">
                    <button type="submit" class="formulario-botao-roxo">Postar</button>
                </footer>
                </footer>


            </form>

        </section>

        <section id="publicacoes">
        @foreach (Publicacao publi in Model)
        {
            if(!publi.ImagemUrl.IsNullOrEmpty()){
            <article class="card-publi">
                <header>
                    <a href="#">
                        <img class="foto-perfil" src="~/images/@publi.Usuario?.FotoPerfilUrl"
                            alt="Foto de perfil">
                        @publi.Usuario?.NomeUsuario
                    </a>
                </header>

                <figure>
                    <img class="imagem-publicacao" src="~/images/@publi.ImagemUrl" alt="">

                    <figcaption class="descricao-publicacao">
                        floflobiuta
                        <p>@publi.Descricao</p>
                    </figcaption>

                    <div class="interacoes-publicacao">
                        <button>
                            <img src="../images/botao coracao verde.svg" alt="">
                        </button>

                        <button>
                            <img src="../images/botao-comentario-verde.svg" alt="">
                        </button>

                        <span>897mil curtidas</span>

                    </div>

                </figure>

                <button>Ver mais comentários...</button>

            </article>

            }

            else 
            {
                <article class="card-publicacao">
                    <header>
                        <a href="#">
                            <img class="foto-perfil" src="../images/1744867899-virginia-instagram.webp" alt="">

                            floflobiuta

                        </a>
                    </header>

                    <figure>
                        <figcaption class="descricao-publicacao">
                            <p class="texto-publi">Hoje fui para Dubai com minha família, nos divertimos muito. Brinquei bastante com meus
                                irmãos!
                                Foi muito divertido! Ganhei novos brinquedos, e conheci diversos lugares novos, fiquei
                                muito feliz.</p>

                        </figcaption>

                        <div class="interacoes-publicacao">
                            <button>
                                <img src="../images/botao coracao verde.svg" alt="">
                            </button>

                            <button>
                                <img src="../images/botao-comentario-verde.svg" alt="">
                            </button>

                            <span>
                                217mil curtidas
                            </span>

                        </div>

                    </figure>
                
                    <button type="button">Ver todos os comentários...</button>

                </article>
            }
        }

        </section>


    </div>

</main>